<!DOCTYPE html>
<html lang="es">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/nav') %>
    <main class="page">
      <h1 class="page-title">Crear cuenta</h1>
      <div class="form-card">
        <%- include('partials/messages') %>
        <form action="/registro" method="post">
          <label class="form-field">
            Nombre
            <input name="nombre" type="text" maxlength="60" autocomplete="name" value="<%= values.nombre || '' %>" required>
          </label>
          <label class="form-field">
            Email
            <input name="email" type="email" maxlength="254" autocomplete="email" value="<%= values.email || '' %>" required>
          </label>
          <label class="form-field">
            Contraseña
            <input name="password" type="password" minlength="8" autocomplete="new-password" required>
            <span class="form-hint">Mínimo 8 caracteres.</span>
          </label>
          <label class="form-field">
            Repite la contraseña
            <input name="passwordConfirmation" type="password" minlength="8" autocomplete="new-password" required>
          </label>
          <button class="button button-primary" type="submit">Crear cuenta</button>
        </form>
        <p class="form-switch">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
