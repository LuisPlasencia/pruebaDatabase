<header class="site-header">
  <a class="site-brand" href="/">TARCE</a>
  <nav class="site-nav" aria-label="Navegación principal">
    <% if (currentUser) { %>
      <a href="/routers" <%- currentPage === 'routers' ? 'aria-current="page"' : '' %>>Mis routers</a>
      <a href="/perfil" <%- currentPage === 'perfil' ? 'aria-current="page"' : '' %>>Mi perfil</a>
      <% if (currentUser.rol === 'admin') { %>
        <a href="/admin/usuarios" <%- currentPage === 'admin' ? 'aria-current="page"' : '' %>>Administración</a>
      <% } %>
      <form class="nav-form" action="/logout" method="post">
        <button class="nav-button" type="submit">Cerrar sesión</button>
      </form>
    <% } else { %>
      <a href="/login" <%- currentPage === 'login' ? 'aria-current="page"' : '' %>>Iniciar sesión</a>
      <a href="/registro" <%- currentPage === 'registro' ? 'aria-current="page"' : '' %>>Crear cuenta</a>
    <% } %>
  </nav>
</header>
